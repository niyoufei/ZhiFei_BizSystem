# 复制为 .env 后按需填写（不要提交 .env 到版本库）

# 服务端口（默认 8000）；若被占用可改为 8080 等
# PORT=8000

# API 认证：多个 key 用逗号分隔；服务未配置时受保护端点 fail-closed 返回 503
# API_KEYS=your-secret-key-1,your-secret-key-2

# 容器部署固定项（详见 docs/container-deployment.md）
# QINGTIAN_ENV=production
# QINGTIAN_API_KEYS_FILE=/run/secrets/qingtian_api_keys
# QINGTIAN_DATA_DIR=/var/lib/qingtian
# QINGTIAN_STORAGE_BACKEND=sqlite
# QINGTIAN_SQLITE_PATH=/var/lib/qingtian/qingtian.sqlite3
# WEB_CONCURRENCY=1
# FORWARDED_ALLOW_IPS=127.0.0.1

# 讯飞星火 HTTP 接口 APIPassword（控制台 HTTP 接口的认证信息）
# 设置后 CLI --mode spark / hybrid 会真实调用星火 API；不设置则回退为规则评分
# SPARK_APIPASSWORD=your-spark-apipassword

# 学习进化 LLM 后端：rules（仅规则）| spark | openai | gemini
# 设为 spark/openai/gemini 并配置对应 API Key 后，进化报告会由该模型增强（高分逻辑与编制指导）
# 默认已按最高端模型配置：OpenAI gpt-4o、Gemini gemini-1.5-pro、星火 4.0Ultra
# 可通过 OPENAI_MODEL / GEMINI_MODEL / SPARK_MODEL 覆盖（如 SPARK_MODEL=generalv3.5）
# EVOLUTION_LLM_BACKEND=rules
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-1.5-pro
# SPARK_MODEL=4.0Ultra

# 限流（可选）
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=100/minute
# RATE_LIMIT_SCORE=30/minute
# RATE_LIMIT_UPLOAD=20/minute
